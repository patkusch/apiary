{
  "name": "apiary",
  "version": "0.1.0",
  "description": "Durable multi-agent orchestration for coding agents — leased tasks, measured memory, no lost work",
  "license": "MIT",
  "author": "patkusch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkusch/apiary.git"
  },
  "bugs": {
    "url": "https://github.com/patkusch/apiary/issues"
  },
  "homepage": "https://github.com/patkusch/apiary#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "tsconfig.json",
    "plugin/commands/",
    "plugin/agents/",
    "plugin/skills/",
    "plugin/pi-skills/",
    "templates/",
    "openapi.json"
  ],
  "module": "src/http.ts",
  "type": "module",
  "bin": {
    "apiary": "./src/cli.tsx"
  },
  "config": {
    "name": "apiary"
  },
  "scripts": {
    "demo": "bun scripts/durability-demo.ts",
    "eval": "bun src/cli.tsx eval",
    "build:pi-skills": "bun run plugin/build-pi-skills.ts",
    "tsc:check": "bun tsc --noEmit",
    "check:db-boundary": "bash scripts/check-db-boundary.sh",
    "cli": "bun src/cli.tsx",
    "hook": "bun src/hooks/hook.ts",
    "claude": "bun src/cli.tsx claude",
    "claude:headless": "bun src/cli.tsx claude --headless",
    "worker": "bun src/cli.tsx worker",
    "worker:yolo": "bun src/cli.tsx worker --yolo",
    "lead": "bun src/cli.tsx lead",
    "lead:yolo": "bun src/cli.tsx lead --yolo",
    "dev": "bun --hot src/stdio.ts",
    "dev:http": "portless api.swarm bun --hot src/http.ts",
    "start": "bun src/stdio.ts",
    "start:http": "bun src/http.ts",
    "start:portless": "portless api.swarm bun src/http.ts",
    "inspector": "bunx @modelcontextprotocol/inspector --transport stdio bun src/stdio.ts",
    "inspector:http": "bunx @modelcontextprotocol/inspector --transport http https://api.swarm.localhost:1355/mcp",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "build:binary": "bun build ./src/cli.tsx --compile --target=bun-linux-x64 --outfile ./dist/apiary",
    "build:binary:arm64": "bun build ./src/cli.tsx --compile --target=bun-linux-arm64 --outfile ./dist/apiary",
    "docker:build:worker": "docker build -f Dockerfile.worker -t apiary-worker:latest .",
    "docker:run:worker": "docker run --rm -it --env-file .env.docker -p 3202:3000 -v ./logs:/logs -v ./work/shared:/workspace/shared -v ./work/worker-1:/workspace/personal apiary-worker:latest",
    "docker:run:lead": "docker run --rm -it --env-file .env.docker-lead -e AGENT_ROLE=lead -p 3201:3000 -v ./logs:/logs -v ./work/shared:/workspace/shared -v ./work/lead:/workspace/personal apiary-worker:latest",
    "deploy:install": "bun deploy/install.ts",
    "deploy:update": "bun deploy/update.ts",
    "deploy:uninstall": "bun deploy/uninstall.ts",
    "deploy:docker": "bun deploy/docker-push.ts",
    "e2e:workflows": "bun scripts/e2e-workflow-test.ts",
    "e2e:workflows:docker": "bun scripts/e2e-workflow-test.ts --with-docker",
    "docs:mcp": "bun scripts/generate-mcp-docs.ts",
    "docs:openapi": "bun scripts/generate-openapi.ts",
    "docs:business-use": "bun scripts/generate-business-use-docs.ts",
    "pm2-start": "pm2 start ecosystem.config.cjs",
    "pm2-stop": "pm2 stop ecosystem.config.cjs",
    "pm2-restart": "pm2 restart ecosystem.config.cjs",
    "pm2-logs": "pm2 logs swarm-api swarm-ui swarm-lead swarm-worker",
    "pm2-status": "pm2 status swarm-api swarm-ui swarm-lead swarm-worker",
    "seed": "bun scripts/seed.ts",
    "seed:clean": "bun scripts/seed.ts --clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@faker-js/faker": "^10.4.0",
    "@opencode-ai/plugin": "1.14.30",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.0.26"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/sdk": "^0.93.0",
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@desplega.ai/business-use": "^0.4.2",
    "@desplega.ai/localtunnel": "^2.2.0",
    "@inkjs/ui": "^2.0.0",
    "@linear/sdk": "^77.0.0",
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openai/codex-sdk": "^0.128.0",
    "@opencode-ai/sdk": "^1.14.30",
    "@slack/bolt": "^4.6.0",
    "@types/react": "^19.2.7",
    "ai": "^6.0.116",
    "cron-parser": "^5.4.0",
    "date-fns": "^4.1.0",
    "hono": "^4.12.3",
    "ink": "^6.5.1",
    "oauth4webapi": "^3.8.5",
    "openai": "^6.22.0",
    "react": "^19.2.3",
    "react-devtools-core": "^7.0.1",
    "sqlite-vec": "^0.1.9",
    "svix": "^1.62.0",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.1"
  }
}
